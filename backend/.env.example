# NeerWatch backend — copy to .env and fill in values before starting.
# Never commit .env or any file containing real credentials.

# HTTP port the server listens on.
# Deployment platforms (Render, Railway, Fly.io) set this automatically.
PORT=5000

# MongoDB connection string.
# Local dev:    mongodb://localhost:27017/neerwatch
# Atlas (prod): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neerwatch
MONGODB_URI=mongodb://localhost:27017/neerwatch

# Node environment. Set to "production" on the deployment platform.
NODE_ENV=development

# Deployed frontend origin — required in production to allow CORS requests.
# Use the exact origin (scheme + host + optional port) of your frontend.
# Comma-separate multiple origins if needed: https://app.example.com,https://www.example.com
# Falls back to http://localhost:3000,http://localhost:5173 when not set (dev only).
FRONTEND_URL=https://your-frontend.example.com

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# JWT token lifetime (any value jsonwebtoken's expiresIn understands: 60, "2 days", "10h")
JWT_EXPIRES_IN=24h

# bcrypt work factor — 12 is recommended for production; lower only for CI/test speed
BCRYPT_ROUNDS=12

# ── Seed user credentials (development / demo only) ───────────────────────────
# These are used ONLY by `npm run seed` to pre-populate user accounts.
# Change every default before any internet-accessible deployment.
SEED_ADMIN_EMAIL=admin@neerwatch.local
SEED_ADMIN_PASSWORD=ChangeThisPassword1!
SEED_OPERATOR_EMAIL=operator@neerwatch.local
SEED_OPERATOR_PASSWORD=ChangeThisPassword2!
SEED_VIEWER_EMAIL=viewer@neerwatch.local
SEED_VIEWER_PASSWORD=ChangeThisPassword3!
