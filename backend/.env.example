# NeerWatch backend — copy to .env and fill in values before starting.
# Never commit .env or any file containing real credentials.

# HTTP port the server listens on.
# Deployment platforms (Render, Railway, Fly.io) set this automatically.
PORT=5000

# MongoDB connection string.
# Local dev:    mongodb://localhost:27017/neerwatch
# Atlas (prod): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neerwatch
MONGODB_URI=mongodb://localhost:27017/neerwatch

# Node environment. Set to "production" on the deployment platform.
NODE_ENV=development

# Deployed frontend origin — required in production to allow CORS requests.
# Use the exact origin (scheme + host + optional port) of your frontend.
# Comma-separate multiple origins if needed: https://app.example.com,https://www.example.com
# Falls back to http://localhost:3000,http://localhost:5173 when not set (dev only).
FRONTEND_URL=https://your-frontend.example.com
