# NEERWATCH Frontend Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Backend API base URL. Do NOT include a trailing slash.
# Confirm the actual backend port with the backend developer before deployment.
VITE_API_BASE_URL=http://localhost:5000

# Set to "true" to use mock data (no backend required).
# Set to "false" to connect to the real backend.
VITE_USE_MOCK=true
